# Render: the server plus the Flutter web build (presenter page and the phone app in a browser),
# in one image. Build context: the repository root. docker-compose keeps using server/Dockerfile.

# --- Flutter web ----------------------------------------------------------------------
FROM debian:bookworm-slim AS web

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl unzip xz-utils ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# The team's Flutter version; no published image has it yet.
RUN git clone --depth 1 --branch 3.47.7 https://github.com/flutter/flutter.git /opt/flutter
ENV PATH=/opt/flutter/bin:$PATH
# Render's builder cannot give files other owners: tar must not keep the archive's owners
# (Flutter unpacks its artifacts with tar).
ENV TAR_OPTIONS=--no-same-owner
RUN flutter config --no-analytics && flutter precache --web

WORKDIR /src
COPY app/pubspec.yaml app/pubspec.lock ./
RUN flutter pub get
COPY app/ ./

# The hosted project's address and its anon key, which is public (the phone apps carry it too).
# A Render environment variable of the same name overrides them (Render passes them as build arguments).
ARG SUPABASE_URL="https://djbbtstcbelgkrfkvdoc.supabase.co"
ARG SUPABASE_ANON_KEY="sb_publishable_XTgg5QQ_qc0er_6B3wJbQA_8hP1iQEh"
RUN flutter build web --release \
      --dart-define=SUPABASE_URL="$SUPABASE_URL" \
      --dart-define=SUPABASE_ANON_KEY="$SUPABASE_ANON_KEY"

# --- Server ---------------------------------------------------------------------------
FROM python:3.14-slim

WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/app ./app
COPY --from=web /src/build/web ./web
# Behind Render's proxy: the client's address comes from X-Forwarded-For (per-IP limits).
ENV WEB_DIR=/srv/web FORWARDED_ALLOW_IPS=*

RUN useradd --no-create-home appuser
USER appuser

# Always 8000, like server/Dockerfile: Render health-checks the port the service was set up with,
# whatever PORT says.
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
