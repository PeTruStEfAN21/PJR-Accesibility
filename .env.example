# Copiază fișierul în .env și completează valorile. .env nu intră în git.

# Cheia se creează din console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# Adresa la care iPhone-ul găsește laptopul cu serverul (IP-ul laptopului în hotspot).
# Pe Windows: ipconfig; pe Mac: ipconfig getifaddr en0.
PUBLIC_URL=http://localhost:8000
