# Copiază fișierul în .env și completează valorile. .env nu intră în git.

# Cheia se creează din console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=

# Adresa la care iPhone-ul găsește laptopul cu serverul (IP-ul laptopului în hotspot).
# Pe Windows: ipconfig; pe Mac: ipconfig getifaddr en0.
PUBLIC_URL=http://localhost:8000

# --- Conturi (Supabase) ---------------------------------------------------------
# Opționale: fără ele serverul merge ca înainte, iar toți utilizatorii sunt anonimi.
# Din supabase.com -> proiectul tău -> Project Settings -> API (sau din `supabase status` local).
SUPABASE_URL=
# Doar pentru proiectele cu secretul JWT vechi (și pentru `supabase start` local).
# Proiectele noi verifică tokenurile cu cheile publice de la SUPABASE_URL; lasă gol.
SUPABASE_JWT_SECRET=
# Cheia service_role NU se pune nicăieri: serverul nu are nevoie de ea.

# Istoricul alarmelor date de colegi, în baza de date (tabelul activity_log), prin rolul echo_audit,
# care poate doar să adauge rânduri. Gol = alarmele se scriu doar în logul serverului.
# Rolul se activează o dată, în SQL editorul Supabase: alter role echo_audit with login password '…';
# Supabase găzduit (pooler): utilizatorul e echo_audit.<project-ref>, de ex.
# AUDIT_DATABASE_URL=postgresql://echo_audit.<project-ref>:<parola>@aws-0-<regiune>.pooler.supabase.com:5432/postgres
# Local (`supabase start`): postgresql://echo_audit:<parola>@localhost:54322/postgres
# AUDIT_DATABASE_URL=

# --- Redis --------------------------------------------------------------------------
# docker compose pornește Redis și setează singur adresa. Gol = sesiuni în memorie (un singur proces).
# REDIS_URL=redis://localhost:6379/0

# --- Limite AI (cereri pe oră) ------------------------------------------------------
# AI_REQUESTS_PER_HOUR=120
# AI_ANONYMOUS_REQUESTS_PER_HOUR=60

# --- Limită meetinguri noi (pe oră, per cont sau IP) --------------------------------
# Crearea unui meeting nu cere cont; limita oprește umplerea serverului cu sesiuni.
# Generoasă: prin Docker pe Mac toate telefoanele pot apărea cu același IP.
# SESSIONS_PER_HOUR=60
